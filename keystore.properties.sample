# これは keystore.properties のサンプルです。
# 実際に使うには、このファイルを「keystore.properties」という名前でコピーし、
# 下記の値を自分のものに書き換えてください。
# 実ファイル(keystore.properties)と *.jks は .gitignore 済みでコミットされません。

# keystore(.jks) ファイルへのパス（このプロジェクトルートからの相対 or 絶対パス推奨）
storeFile=/Users/uebetsunawayuuya/keystores/countergraph-release.jks
# keystore のパスワード
storePassword=ここにkeystoreパスワード
# 鍵の別名(alias)
keyAlias=countergraph
# 鍵のパスワード（keytoolで -keypass を分けなければ storePassword と同じ）
keyPassword=ここにキーのパスワード
